{
  "name": "democratic-party-crosscurrents",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:data": "node scripts/build-data.mjs",
    "check:data": "node scripts/validate-data.mjs",
    "check:model": "node scripts/test-model.mjs",
    "check:taxonomy": "node scripts/test-taxonomy.mjs",
    "check:client": "node --experimental-strip-types scripts/test-client-state.mjs",
    "check": "npm run check:data && npm run check:model && npm run check:taxonomy && npm run check:client && tsc -b --pretty false",
    "refresh:fec": "node scripts/refresh-fec.mjs",
    "test": "npm run build:data && npm run check && npm run build"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "dexie": "^4.2.0",
    "dexie-export-import": "^4.1.4",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
